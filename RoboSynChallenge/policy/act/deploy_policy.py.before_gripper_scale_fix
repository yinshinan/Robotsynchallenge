# ----------------------------------------------------------------------------
# LeRobot ACT Policy Adapter for RoboSynChallenge
#
# Follows the same unified evaluation interface as policy/pi0:
#   - get_model(usr_args) -> model
#   - eval(env, model, obs) -> obs, info, truncated
#   - reset_model(model) -> None
# ----------------------------------------------------------------------------

import numpy as np
import torch

from lerobot.configs.policies import PreTrainedConfig
from lerobot.policies.act.modeling_act import ACTPolicy

def get_model(usr_args):
    checkpoint_path = usr_args.get("checkpoint_path")
    if checkpoint_path is None:
        raise ValueError("checkpoint_path must be provided in usr_args.")

    device = usr_args.get("device", usr_args.get("pytorch_device", "cuda"))
    cli_overrides = [f"--device={device}"]
    try:
        policy = ACTPolicy.from_pretrained(
            checkpoint_path,
            cli_overrides=cli_overrides,
        )
    except TypeError as exc:
        if "cli_overrides" not in str(exc):
            raise
        config = PreTrainedConfig.from_pretrained(
            checkpoint_path,
            cli_overrides=cli_overrides,
        )
        policy = ACTPolicy.from_pretrained(checkpoint_path, config=config)
    policy.eval()

    # ACT normally executes ``config.n_action_steps`` predictions from each
    # generated chunk before observing the environment and planning again.
    # Allow evaluation-time override for diagnosing action-chunk drift while
    # retaining the checkpoint value when no override is provided.
    requested_n_action_steps = usr_args.get("n_action_steps")
    if requested_n_action_steps is not None:
        requested_n_action_steps = int(requested_n_action_steps)
        if not 1 <= requested_n_action_steps <= int(policy.config.chunk_size):
            raise ValueError(
                "n_action_steps must be between 1 and "
                f"chunk_size ({policy.config.chunk_size}), got "
                f"{requested_n_action_steps}."
            )
        policy.config.n_action_steps = requested_n_action_steps
        policy.reset()

    print(
        "[ACT CONFIG]",
        f"chunk_size={policy.config.chunk_size}",
        f"n_action_steps={policy.config.n_action_steps}",
        flush=True,
    )

    image_key_map = {
        "observation.images.cam_high": "cam_high",
        "observation.images.cam_right_wrist": "cam_right_wrist",
        "observation.images.cam_left_wrist": "cam_left_wrist",
    }
    image_key_map.update(usr_args.get("image_key_map") or {})
    image_keys = list(policy.config.image_features.keys())
    for image_key in image_keys:
        image_key_map.setdefault(
            image_key,
            image_key.removeprefix("observation.images."),
        )

    policy.act_device = next(policy.parameters()).device
    policy.act_step = int(usr_args.get("act_step", 8))
    policy.state_obs_path = usr_args.get("state_obs_path", "robot/qpos")
    policy.strict_action_dim = bool(usr_args.get("strict_action_dim", True))
    policy.neutralize_qvel = bool(usr_args.get("neutralize_qvel", False))
    policy.debug_button_press = bool(usr_args.get("debug_button_press", False))
    policy.act_image_keys = image_keys
    policy.image_key_map = image_key_map

    if policy.act_step <= 0:
        raise ValueError(f"act_step must be positive, got {policy.act_step}.")

    return policy

def eval(env, model, obs):
    final_obs = obs
    info = None
    truncated = False

    for _ in range(model.act_step):
        if model.debug_button_press:
            button_qpos = env.unwrapped.sim.get_articulation("button").get_qpos()
            press_depth = float((-button_qpos[:, 0]).max().item())
            model._max_button_press_depth = max(
                model._max_button_press_depth,
                press_depth,
            )

        state = final_obs
        for key in str(model.state_obs_path).split("/"):
            if key:
                state = state[key]
        state_tensor = state.detach().to(device=model.act_device, dtype=torch.float32) if isinstance(state, torch.Tensor) else torch.as_tensor(state, dtype=torch.float32, device=model.act_device)
        if state_tensor.ndim == 1:
            state_tensor = state_tensor.unsqueeze(0)

        qvel_tensor = torch.as_tensor(
            final_obs["robot"]["qvel"],
            dtype=torch.float32,
            device=model.act_device,
        )
        qf_tensor = torch.as_tensor(
            final_obs["robot"]["qf"],
            dtype=torch.float32,
            device=model.act_device,
        )

        if qvel_tensor.ndim == 1:
            qvel_tensor = qvel_tensor.unsqueeze(0)
        if qf_tensor.ndim == 1:
            qf_tensor = qf_tensor.unsqueeze(0)

        raw_qvel_tensor = qvel_tensor.clone()
        if model.neutralize_qvel:
            qvel_mean = model.normalize_inputs.buffer_observation_qvel["mean"]
            qvel_tensor = qvel_mean.to(
                device=model.act_device,
                dtype=torch.float32,
            ).unsqueeze(0).expand_as(qvel_tensor)

        if not getattr(model, "_input_debug_printed", False):
            normalized_debug = model.normalize_inputs(
                {
                    "observation.state": state_tensor.clone(),
                    "observation.qvel": qvel_tensor.clone(),
                    "observation.qf": qf_tensor.clone(),
                }
            )
            print("[INPUT DEBUG] state shape:", tuple(state_tensor.shape))
            print("[INPUT DEBUG] state absmax:", state_tensor.abs().max().item())
            print("[INPUT DEBUG] state:", state_tensor[0].detach().cpu().tolist())
            print(
                "[INPUT DEBUG] normalized state absmax:",
                normalized_debug["observation.state"].abs().max().item(),
            )
            print(
                "[INPUT DEBUG] normalized state:",
                normalized_debug["observation.state"][0].detach().cpu().tolist(),
            )
            print("[INPUT DEBUG] qvel shape:", tuple(qvel_tensor.shape))
            print("[INPUT DEBUG] neutralize qvel:", model.neutralize_qvel)
            print(
                "[INPUT DEBUG] raw qvel absmax:",
                raw_qvel_tensor.abs().max().item(),
            )
            print(
                "[INPUT DEBUG] raw qvel:",
                raw_qvel_tensor[0].detach().cpu().tolist(),
            )
            print("[INPUT DEBUG] qvel absmax:", qvel_tensor.abs().max().item())
            print("[INPUT DEBUG] qvel:", qvel_tensor[0].detach().cpu().tolist())
            print(
                "[INPUT DEBUG] normalized qvel absmax:",
                normalized_debug["observation.qvel"].abs().max().item(),
            )
            print(
                "[INPUT DEBUG] normalized qvel:",
                normalized_debug["observation.qvel"][0].detach().cpu().tolist(),
            )
            print("[INPUT DEBUG] qf shape:", tuple(qf_tensor.shape))
            print("[INPUT DEBUG] qf absmax:", qf_tensor.abs().max().item())
            print("[INPUT DEBUG] qf:", qf_tensor[0].detach().cpu().tolist())
            model._input_debug_printed = True

        batch = {
            "observation.state": state_tensor,
            "observation.qvel": qvel_tensor,
            "observation.qf": qf_tensor,
        }
        for image_key in model.act_image_keys:
            camera_name = model.image_key_map.get(
                image_key,
                image_key.removeprefix("observation.images."),
            )
            image = final_obs["sensor"][camera_name]["color"]
            image_tensor = image.detach().to(device=model.act_device, dtype=torch.float32) if isinstance(image, torch.Tensor) else torch.as_tensor(image, dtype=torch.float32, device=model.act_device)
            if image_tensor.ndim == 3:
                image_tensor = image_tensor.unsqueeze(0)
            image_tensor = image_tensor[..., :3].permute(0, 3, 1, 2).contiguous()
            if torch.max(image_tensor) > 1.5:
                image_tensor = image_tensor / 255.0
            batch[image_key] = image_tensor

        action = model.select_action(batch)

        if not hasattr(model, "_gripper_debug_count"):
            model._gripper_debug_count = 0

        if model._gripper_debug_count % 10 == 0:
            print(
                "[GRIPPER DEBUG]",
                f"step={model._gripper_debug_count}",
                f"left_state={state_tensor[0, 6].item():.4f}",
                f"left_action={action[0, 6].item():.4f}",
                f"right_state={state_tensor[0, 13].item():.4f}",
                f"right_action={action[0, 13].item():.4f}",
                f"right_arm_error={torch.mean(torch.abs(action[0, 7:13] - state_tensor[0, 7:13])).item():.4f}",
                flush=True,
            )

        model._gripper_debug_count += 1

        if not hasattr(model, "_action_debug_count"):
            model._action_debug_count = 0

        if model._action_debug_count < 10:
            left_delta = torch.mean(
                torch.abs(action[0, :7] - state_tensor[0, :7])
            ).item()
            right_delta = torch.mean(
                torch.abs(action[0, 7:14] - state_tensor[0, 7:14])
            ).item()

            print(
                f"[ACTION DEBUG] "
                f"left_delta={left_delta:.6f}, "
                f"right_delta={right_delta:.6f}"
            )

        model._action_debug_count += 1

        if action.ndim == 1:
            action = action.unsqueeze(0)
        if action.ndim != 2:
            raise ValueError(f"Expected policy action shape [B, D], but got {tuple(action.shape)}.")

        env_action_dim = int(np.prod(env.unwrapped.single_action_space.shape))
        policy_action_dim = int(action.shape[-1])
        if policy_action_dim != env_action_dim:
            message = f"Policy action has dim {policy_action_dim}, but env expects {env_action_dim}."
            if model.strict_action_dim or policy_action_dim < env_action_dim:
                raise ValueError(message)
            action = action[:, :env_action_dim]

        action_tensor = action.detach().to(
            device=env.unwrapped.device,
            dtype=torch.float32,
        )
        final_obs, reward, terminated, truncated, info = env.step(action_tensor)
        def _is_done(value):
            if isinstance(value, torch.Tensor):
                return bool(value.any().item())
            if isinstance(value, np.ndarray):
                return bool(value.any())
            return bool(value)

        is_terminated = _is_done(terminated)
        is_truncated = _is_done(truncated)

        if is_terminated or is_truncated:
            if model.debug_button_press:
                print(
                    "[PRESS DEBUG] max_press_depth=",
                    model._max_button_press_depth,
                    "success_threshold=",
                    0.0048,
                    flush=True,
                )
            print(
                "[DONE DEBUG]",
                "terminated=", terminated,
                "truncated=", truncated,
                "info=", info,
                flush=True,
            )
            truncated = True
            break

    return final_obs, info, truncated


def reset_model(model):
    model.reset()
    model._max_button_press_depth = 0.0
